# Netlify response headers (same syntax works on Cloudflare Pages).
# Apache/Hostinger equivalent: deploy/hostinger/.htaccess
# Note: Netlify only allows * at the END of a path segment.
# CSP inline-script/style sources are filled in by scripts/build.mjs from
# data/site.json → hosting.netlifyFreePlanBadge (see docs/DEPLOYMENT.md §1).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'{{STYLE_SRC_EXTRA}}; font-src 'self'; script-src 'self' {{INLINE_SCRIPT_HASHES}}; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# CSS/JS URLs carry ?v=<content-hash>; fonts and images are renamed when replaced.
# HTML keeps Netlify's default (max-age=0, must-revalidate).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
